---
import Icon from './Icon.astro';
/**
 * Click-to-load YouTube facade. Nothing from YouTube downloads until the
 * visitor taps play, which matters on expensive mobile data.
 * Thumbnails are fetched from i.ytimg.com only when the poster scrolls near.
 */
interface Props {
  id: string;
  title: string;
  transitionName?: string;
}
const { id, title, transitionName } = Astro.props;
---

<div class="yt frame" data-yt={id} transition:name={transitionName}>
  <img src={`https://i.ytimg.com/vi/${id}/hqdefault.jpg`} alt="" loading="lazy" decoding="async" width="480" height="360" />
  <button class="yt__play" type="button" aria-label={`Play: ${title}`}>
    <span class="yt__icon"><Icon name="play" /></span>
  </button>
</div>

<script>
  function setupYouTube() {
    document.querySelectorAll<HTMLElement>('[data-yt]').forEach((el) => {
      el.querySelector('button')?.addEventListener(
        'click',
        () => {
          const id = el.dataset.yt;
          const iframe = document.createElement('iframe');
          iframe.src = `https://www.youtube-nocookie.com/embed/${id}?autoplay=1&rel=0`;
          iframe.title = el.querySelector('button')?.getAttribute('aria-label') ?? 'YouTube video';
          iframe.allow = 'accelerometer; autoplay; encrypted-media; gyroscope; picture-in-picture';
          iframe.allowFullscreen = true;
          el.replaceChildren(iframe);
        },
        { once: true },
      );
    });
  }
  document.addEventListener('astro:page-load', setupYouTube);
</script>

<style>
  .yt {
    aspect-ratio: 16 / 9;
  }
  .yt img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .yt__play {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    background: rgb(0 0 0 / 0.25);
    transition: background var(--dur-fast);
  }
  .yt__play:hover {
    background: rgb(0 0 0 / 0.1);
  }
  .yt__icon {
    display: grid;
    place-items: center;
    width: 4.5rem;
    height: 4.5rem;
    border-radius: var(--radius);
    background: var(--c-accent);
    color: #fff;
    transition: transform var(--dur-fast) var(--ease-out);
  }
  .yt__icon :global(svg) {
    width: 1.6rem;
    height: 1.6rem;
  }
  .yt__play:hover .yt__icon {
    transform: scale(1.06);
  }
  .yt :global(iframe) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }
</style>
