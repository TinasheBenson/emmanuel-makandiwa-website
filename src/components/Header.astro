---
import { nav, navSecondary, site } from '../data/site';

const path = Astro.url.pathname;
const isActive = (href: string) => path === href || (href !== '/' && path.startsWith(href));
const all = [...nav, ...navSecondary];
---

<header class="header" data-header transition:name="site-header">
  <div class="header__inner container">
    <a href="/" class="brand" aria-label={`${site.name}, home`}>
      <!-- TODO: replace with the official logo from the current site -->
      <span class="brand__mark" aria-hidden="true">EM</span>
      <span class="brand__name">Emmanuel Makandiwa</span>
    </a>

    <nav class="nav" aria-label="Primary">
      <ul>
        {
          nav.map((item) => (
            <li>
              <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
                {item.label}
                {isActive(item.href) && <span class="nav__indicator" transition:name="nav-indicator" />}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="header__actions">
      <a href="/give/" class="btn header__give">Give</a>
      <button class="menu-btn" type="button" aria-expanded="false" aria-controls="site-menu" data-menu-toggle>
        <span class="visually-hidden">Menu</span>
        <span class="menu-btn__bars" aria-hidden="true"><i></i><i></i></span>
      </button>
    </div>
  </div>

  <div class="menu" id="site-menu" data-menu hidden>
    <nav class="container menu__inner" aria-label="Menu">
      <ol class="menu__list">
        {
          all.map((item, i) => (
            <li style={`--i:${i}`}>
              <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
                <span class="menu__num">{String(i + 1).padStart(2, '0')}</span>
                {item.label}
              </a>
            </li>
          ))
        }
      </ol>
      <div class="menu__foot" style={`--i:${all.length}`}>
        <a href={`mailto:${site.email}`} class="link-underline">{site.email}</a>
        <ul class="menu__socials">
          {site.socials.map((s) => <li><a href={s.href} target="_blank" rel="noopener">{s.label}</a></li>)}
        </ul>
      </div>
    </nav>
  </div>
</header>

<script>
  function setupMenu() {
    const btn = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
    const menu = document.querySelector<HTMLElement>('[data-menu]');
    if (!btn || !menu) return;
    const root = document.documentElement;
    const close = () => {
      root.classList.remove('menu-open');
      btn.setAttribute('aria-expanded', 'false');
      window.__lenis?.start();
      setTimeout(() => {
        if (!root.classList.contains('menu-open')) menu.hidden = true;
      }, 600);
    };
    const open = () => {
      menu.hidden = false;
      requestAnimationFrame(() => root.classList.add('menu-open'));
      btn.setAttribute('aria-expanded', 'true');
      window.__lenis?.stop();
    };
    btn.addEventListener('click', () => (root.classList.contains('menu-open') ? close() : open()));
    menu.querySelectorAll('a').forEach((a) => a.addEventListener('click', close));
    closeMenu = () => {
      close();
      btn.focus();
    };
  }
  let closeMenu: (() => void) | null = null;
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && document.documentElement.classList.contains('menu-open')) closeMenu?.();
  });
  document.addEventListener('astro:page-load', setupMenu);
  document.addEventListener('astro:before-swap', () => document.documentElement.classList.remove('menu-open'));
</script>

<style>
  .header {
    position: fixed;
    inset: 0 0 auto;
    z-index: 100;
    height: var(--header-h);
    color: var(--c-text);
    transition:
      transform var(--dur) var(--ease-out),
      background-color var(--dur) var(--ease-out),
      color var(--dur) var(--ease-out);
  }
  .header.is-scrolled {
    background: color-mix(in oklab, var(--c-ink) 78%, transparent);
    backdrop-filter: blur(14px) saturate(1.2);
    -webkit-backdrop-filter: blur(14px) saturate(1.2);
  }
  .header.is-scrolled.on-light {
    background: color-mix(in oklab, var(--c-paper) 82%, transparent);
    color: var(--c-text-ink);
  }
  .header.is-hidden {
    transform: translateY(-100%);
  }
  :global(html.menu-open) .header {
    background: transparent;
    color: var(--c-text);
    backdrop-filter: none;
  }

  .header__inner {
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    position: relative;
    z-index: 2;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  .brand__mark {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    background: var(--c-accent);
    color: #fff;
    border-radius: var(--radius);
    font-family: var(--ff-display);
    font-size: 1rem;
    font-weight: 800;
    font-stretch: 75%;
  }
  .brand__name {
    font-family: var(--ff-display);
    font-size: 1.15rem;
    font-weight: 800;
    font-stretch: 75%;
    letter-spacing: 0.01em;
    text-transform: uppercase;
  }

  .nav ul {
    display: flex;
    gap: 2rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .nav a {
    position: relative;
    font-family: var(--ff-ui);
    font-size: 0.85rem;
    font-weight: 600;
    font-stretch: 92%;
    letter-spacing: 0.02em;
    opacity: 0.8;
    transition: opacity var(--dur-fast);
  }
  .nav a:hover,
  .nav a[aria-current='page'] {
    opacity: 1;
  }
  .nav__indicator {
    position: absolute;
    left: 0;
    right: 0;
    bottom: -8px;
    height: 2px;
    background: var(--c-accent-text);
  }

  .header__actions {
    display: flex;
    align-items: center;
    gap: 1rem;
  }
  .header__give {
    padding: 0.7rem 1.3rem;
  }

  .menu-btn {
    display: none;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: var(--radius);
    box-shadow: inset 0 0 0 1.5px currentColor;
    place-items: center;
  }
  .menu-btn__bars {
    position: relative;
    width: 18px;
    height: 8px;
  }
  .menu-btn__bars i {
    position: absolute;
    left: 0;
    width: 100%;
    height: 1.5px;
    background: currentColor;
    transition: transform var(--dur) var(--ease-out), top var(--dur) var(--ease-out);
  }
  .menu-btn__bars i:first-child {
    top: 0;
  }
  .menu-btn__bars i:last-child {
    top: 100%;
  }
  :global(html.menu-open) .menu-btn__bars i:first-child {
    top: 50%;
    transform: rotate(45deg);
  }
  :global(html.menu-open) .menu-btn__bars i:last-child {
    top: 50%;
    transform: rotate(-45deg);
  }

  /* Full-screen menu: a curtain drops, then the links rise one by one. */
  .menu {
    position: fixed;
    inset: 0;
    z-index: 1;
    background: var(--c-ink);
    clip-path: inset(0 0 100% 0);
    transition: clip-path 0.8s var(--ease-in-out);
    overflow-y: auto;
  }
  :global(html.menu-open) .menu {
    clip-path: inset(0 0 0 0);
  }
  .menu__inner {
    min-height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding-top: calc(var(--header-h) + 2rem);
    padding-bottom: 2rem;
  }
  .menu__list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .menu__list li,
  .menu__foot {
    opacity: 0;
    transform: translateY(30px);
    transition:
      opacity 0.6s var(--ease-out),
      transform 0.8s var(--ease-out);
    transition-delay: calc(0.25s + var(--i) * 0.05s);
  }
  :global(html.menu-open) .menu__list li,
  :global(html.menu-open) .menu__foot {
    opacity: 1;
    transform: none;
  }
  .menu__list a {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    padding: 0.35rem 0;
    font-family: var(--ff-display);
    font-size: clamp(2.2rem, 8vw, 4.5rem);
    font-weight: 800;
    font-stretch: 72%;
    text-transform: uppercase;
    line-height: 1.05;
    border-bottom: 1px solid var(--c-line);
  }
  .menu__list a[aria-current='page'] {
    color: var(--c-accent-text);
  }
  .menu__num {
    font-family: var(--ff-ui);
    font-size: 0.8rem;
    color: var(--c-accent-text);
    letter-spacing: 0.1em;
  }
  .menu__foot {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 3rem;
    font-family: var(--ff-ui);
    font-size: 0.9rem;
  }
  .menu__socials {
    display: flex;
    gap: 1.25rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  @media (max-width: 1080px) {
    .nav {
      display: none;
    }
    .menu-btn {
      display: grid;
    }
  }
  @media (max-width: 520px) {
    .brand__name {
      display: none;
    }
    .header__give {
      display: none;
    }
  }
</style>
