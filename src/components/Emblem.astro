---
/**
 * Scroll-driven emblem: sun → fire → cross, morphing between Phosphor icon
 * shapes (MIT, github.com/phosphor-icons/core) with MorphSVGPlugin (motion.ts).
 */
import sun from '@phosphor-icons/core/assets/fill/sun-fill.svg?raw';
import fire from '@phosphor-icons/core/assets/fill/fire-fill.svg?raw';
import cross from '@phosphor-icons/core/assets/fill/cross-fill.svg?raw';

interface Props {
  class?: string;
}
const { class: cls } = Astro.props;
const pathOf = (svg: string) => svg.match(/<path d="([^"]+)"/)?.[1] ?? '';
const shapes = [sun, fire, cross].map(pathOf);
---

<div class:list={['emblem', cls]} aria-hidden="true">
  <svg viewBox="0 0 256 256" data-morph>
    {shapes.map((d) => <path d={d} data-morph-shape fill="currentColor" />)}
  </svg>
</div>

<style>
  .emblem {
    aspect-ratio: 1;
  }
  .emblem svg {
    width: 100%;
    height: 100%;
    overflow: visible;
  }
  /* Without the morph running, show only the cross. */
  .emblem path:not(:last-child) {
    display: none;
  }
  :global(html.js:not([data-motion='reduced'])) .emblem path {
    display: block;
  }
</style>
