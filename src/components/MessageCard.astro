---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

interface Props {
  entry: CollectionEntry<'messages'>;
  size?: 'default' | 'large';
}
const { entry, size = 'default' } = Astro.props;
const { title, date, series, image, placeholder } = entry.data;
const fmt = new Intl.DateTimeFormat('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
---

<article class:list={['mcard', `mcard--${size}`]}>
  <a href={`/messages/${entry.id}/`} class="mcard__link">
    <div class="mcard__media frame" transition:name={`message-media-${entry.id}`}>
      <Image src={image} alt="" widths={[480, 800, 1200]} sizes={size === 'large' ? '(max-width: 900px) 100vw, 60vw' : '(max-width: 900px) 100vw, 33vw'} />
      {placeholder && <span class="tag-sample">Sample</span>}
    </div>
    <div class="mcard__text" data-reveal="up">
      <div class="mcard__meta">
        {series && <span>{series}</span>}
        <time datetime={date.toISOString()}>{fmt.format(date)}</time>
      </div>
      <h3 class="mcard__title">{title}</h3>
    </div>
  </a>
</article>

<style>
  .mcard__link {
    display: block;
  }
  .mcard__media {
    aspect-ratio: 16 / 10;
    margin-bottom: 1.25rem;
  }
  .mcard--large .mcard__media {
    aspect-ratio: 16 / 9;
  }
  .mcard__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1.2s var(--ease-out);
  }
  .mcard__link:hover .mcard__media :global(img) {
    transform: scale(1.06);
  }
  .mcard__meta {
    display: flex;
    gap: 1rem;
    font-family: var(--ff-ui);
    font-size: var(--fs-eyebrow);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--c-accent-text);
    margin-bottom: 0.6rem;
  }
  .mcard__title {
    font-size: var(--fs-h3);
    width: fit-content;
  }
  .mcard--large .mcard__title {
    font-size: var(--fs-h2);
  }
</style>
