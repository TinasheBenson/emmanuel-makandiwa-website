---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  eyebrow: string;
  title: string;
  lead?: string;
  image?: ImageMetadata;
  imageAlt?: string;
  transitionName?: string;
}

const { eyebrow, title, lead, image, imageAlt = '', transitionName } = Astro.props;
---

<section class:list={['page-hero', { 'page-hero--media': image }]}>
  <div class="container page-hero__inner">
    <div class="page-hero__copy">
      <p class="eyebrow" data-reveal="fade">{eyebrow}</p>
      <h1 class="page-hero__title" data-split="hero">{title}</h1>
      {lead && <p class="lead dim page-hero__lead" data-reveal="up">{lead}</p>}
      <slot />
    </div>
    {
      image && (
        <div class="page-hero__media frame" transition:name={transitionName}>
          <Image src={image} alt={imageAlt} widths={[600, 900, 1300]} sizes="(max-width: 900px) 100vw, 45vw" loading="eager" fetchpriority="high" data-parallax="0.06" />
        </div>
      )
    }
  </div>
</section>

<style>
  .page-hero {
    position: relative;
    overflow: hidden;
    padding-top: calc(var(--header-h) + clamp(4rem, 10vw, 8rem));
    padding-bottom: clamp(3rem, 7vw, 6rem);
    background: var(--c-ink);
    border-bottom: 1px solid var(--c-line);
  }
  .page-hero__inner {
    display: grid;
    gap: clamp(2rem, 5vw, 5rem);
    align-items: end;
  }
  .page-hero--media .page-hero__inner {
    grid-template-columns: 1.1fr 0.9fr;
  }
  .page-hero__title {
    font-size: var(--fs-h1);
    margin-bottom: 1.75rem;
    max-width: 14ch;
  }
  .page-hero__lead {
    max-width: 38rem;
  }
  .page-hero__media {
    aspect-ratio: 4 / 5;
    max-height: 72vh;
  }
  .page-hero__media :global(img) {
    width: 100%;
    height: 112%;
    object-fit: cover;
  }
  @media (max-width: 900px) {
    .page-hero--media .page-hero__inner {
      grid-template-columns: 1fr;
    }
    .page-hero__media {
      aspect-ratio: 4 / 3;
    }
  }
</style>
