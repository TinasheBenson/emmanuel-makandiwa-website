---
import Icon from './Icon.astro';
import { nav, navSecondary, site } from '../data/site';
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container">
    <div class="footer__cta">
      <h2 class="footer__title" data-split>Stay in touch</h2>
      <p class="lead dim" data-reveal="up">New sermons go up on YouTube every week. Subscribe there, or write to us.</p>
      <div class="footer__cta-actions" data-reveal="up">
        <a class="btn" href={site.youtube.channelUrl} target="_blank" rel="noopener">
          <Icon name="youtube" /> Subscribe on YouTube
        </a>
        <a class="btn btn--ghost" href="/contact-and-support/"><span>Contact us</span></a>
      </div>
    </div>

    <div class="footer__grid">
      <div>
        <p class="footer__label">Pages</p>
        <ul>{[...nav, ...navSecondary].map((l) => <li><a class="link-underline" href={l.href}>{l.label}</a></li>)}</ul>
      </div>
      <div>
        <p class="footer__label">Follow</p>
        <ul>
          {site.socials.map((s) => <li><a class="link-underline" href={s.href} target="_blank" rel="noopener">{s.label}</a></li>)}
        </ul>
      </div>
      <div>
        <p class="footer__label">Related</p>
        <ul>
          <li><a class="link-underline" href={site.church.url} target="_blank" rel="noopener">{site.church.name}</a></li>
          <li><a class="link-underline" href={site.ruth.url} target="_blank" rel="noopener">{site.ruth.name}</a></li>
        </ul>
      </div>
      <div>
        <p class="footer__label">Email</p>
        <a class="link-underline" href={`mailto:${site.email}`}>{site.email}</a>
        <fieldset class="motion-toggle" data-motion-toggle>
          <legend class="footer__label">Animation</legend>
          <label><input type="radio" name="motion" value="full" /> Full</label>
          <label><input type="radio" name="motion" value="lite" /> Data saver</label>
          <label><input type="radio" name="motion" value="reduced" /> Off</label>
        </fieldset>
      </div>
    </div>

    <p class="footer__mark" aria-hidden="true">Emmanuel Makandiwa</p>

    <div class="footer__base">
      <p>© {year} {site.title}</p>
      <p><a href="/credits/" class="link-underline">Photo and font credits</a></p>
      <p><a href="#main" class="link-underline footer__top">Back to top <Icon name="arrowUp" /></a></p>
    </div>
  </div>
</footer>

<script>
  // Lets visitors override the automatic motion tier (e.g. to save data).
  function setupToggle() {
    const box = document.querySelector('[data-motion-toggle]');
    if (!box) return;
    const current = document.documentElement.dataset.motion;
    box.querySelectorAll<HTMLInputElement>('input').forEach((input) => {
      input.checked = input.value === current;
      input.addEventListener('change', () => {
        try {
          localStorage.setItem('motion', input.value);
        } catch {}
        location.reload();
      });
    });
  }
  document.addEventListener('astro:page-load', setupToggle);
</script>

<style>
  .footer {
    position: relative;
    overflow: hidden;
    background: var(--c-ink);
    padding-top: var(--section);
    border-top: 1px solid var(--c-line);
  }
  .footer__cta {
    max-width: 760px;
    margin-bottom: clamp(4rem, 8vw, 7rem);
  }
  .footer__title {
    font-size: var(--fs-h1);
    margin-bottom: 1.5rem;
  }
  .footer__cta-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }
  .footer__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 2rem;
    padding-block: 3rem;
    border-top: 1px solid var(--c-line);
    font-family: var(--ff-ui);
    font-size: 0.95rem;
  }
  .footer__grid ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.5rem;
  }
  .footer__label {
    font-family: var(--ff-ui);
    font-size: var(--fs-eyebrow);
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--c-text-dim);
    margin-bottom: 1rem;
  }
  .motion-toggle {
    margin: 2rem 0 0;
    padding: 0;
    border: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1rem;
  }
  .motion-toggle legend {
    padding: 0;
  }
  .motion-toggle label {
    display: inline-flex;
    gap: 0.4rem;
    align-items: center;
    cursor: pointer;
  }
  .motion-toggle input {
    accent-color: var(--c-accent);
  }
  .footer__mark {
    margin: 0;
    padding-block: 1.5rem 0.5rem;
    font-family: var(--ff-display);
    font-size: clamp(3rem, 11.2vw, 11.5rem);
    font-weight: 800;
    font-stretch: 62%;
    line-height: 0.85;
    text-transform: uppercase;
    white-space: nowrap;
    color: var(--c-ink-2);
  }
  .footer__base {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 2rem;
    border-top: 1px solid var(--c-line);
    font-family: var(--ff-ui);
    font-size: var(--fs-small);
    color: var(--c-text-dim);
  }
  .footer__base p {
    margin: 0;
  }
  .footer__top {
    display: inline-flex;
    gap: 0.35rem;
    align-items: center;
  }
  .footer__top :global(.icon) {
    width: 0.9em;
    height: 0.9em;
  }
  @media (max-width: 860px) {
    .footer__grid {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
