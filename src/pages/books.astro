---
import { getCollection, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import BookCard from '../components/BookCard.astro';
import Icon from '../components/Icon.astro';

const books = (await getCollection('books')).sort((a, b) => a.data.order - b.data.order);
const rendered = await Promise.all(books.map(async (b) => ({ book: b, Content: (await render(b)).Content })));
---

<Base title="Life Lighter" description="Life Lighter, the monthly devotional by Emmanuel and Ruth Makandiwa, with links to each edition.">
  <PageHero
    eyebrow="Books"
    title="Life Lighter"
    lead="A reading for every day of the month by Emmanuel and Ruth Makandiwa: a short message, a Bible passage, a declaration and a prayer. Published monthly, in English and Shona."
  />

  <section class="section library">
    <div class="container library__grid">
      {
        rendered.map(({ book, Content }) => (
          <article class="book">
            <div class="book__cover">
              <BookCard book={book} sizes="(max-width: 700px) 70vw, 22vw" />
            </div>
            <div class="book__info" data-reveal="up">
              <h2>{book.data.title}</h2>
              {book.data.subtitle && <p class="book__sub">{book.data.subtitle}</p>}
              <p class="dim book__authors">{book.data.authors}</p>
              <div class="dim book__desc"><Content /></div>
              <div class="book__links">
                {book.data.links.map((l) => (
                  <a class="btn btn--ghost" href={l.href} target="_blank" rel="noopener"><span>{l.label}</span> <Icon name="arrowUpRight" /></a>
                ))}
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </section>
</Base>

<style>
  .library {
    padding-top: clamp(3rem, 6vw, 5rem);
  }
  .library__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: clamp(3rem, 6vw, 5rem) clamp(2rem, 5vw, 5rem);
  }
  .book {
    display: grid;
    grid-template-columns: minmax(140px, 0.8fr) 1.2fr;
    gap: 2rem;
    align-items: start;
  }
  .book__cover {
    transform: perspective(900px) rotateY(-10deg);
    transform-origin: left center;
    transition: transform 0.9s var(--ease-out);
  }
  .book:hover .book__cover {
    transform: perspective(900px) rotateY(0deg) translateY(-6px);
  }
  .book h2 {
    font-size: var(--fs-h3);
    font-stretch: 80%;
    margin-bottom: 0.4rem;
  }
  .book__sub {
    font-style: italic;
    font-size: 1.1rem;
    margin-bottom: 0.4rem;
  }
  .book__authors {
    font-family: var(--ff-ui);
    font-size: var(--fs-small);
    margin-bottom: 1rem;
  }
  .book__desc {
    font-size: 1rem;
  }
  .book__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  @media (max-width: 1000px) {
    .library__grid {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 520px) {
    .book {
      grid-template-columns: 1fr;
    }
    .book__cover {
      max-width: 220px;
    }
  }
</style>
