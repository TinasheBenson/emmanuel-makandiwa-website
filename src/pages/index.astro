---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Film from '../components/Film.astro';
import MessageCard from '../components/MessageCard.astro';
import BookCard from '../components/BookCard.astro';
import Emblem from '../components/Emblem.astro';
import Icon from '../components/Icon.astro';

import earthAtNight from '../assets/media/earth-at-night.jpg';
import oilLamp from '../assets/media/oil-lamp.jpg';
import bibleLights from '../assets/media/bible-lights.jpg';
import { stories } from '../data/gatherings';

const messages = (await getCollection('messages')).sort((a, b) => {
  if (a.data.featured !== b.data.featured) return a.data.featured ? -1 : 1;
  return b.data.date.valueOf() - a.data.date.valueOf();
});
const [featured, ...rest] = messages;
const books = (await getCollection('books')).sort((a, b) => a.data.order - b.data.order).slice(0, 3);
const now = new Date();
const events = (await getCollection('events'))
  .filter((e) => e.data.start >= now)
  .sort((a, b) => a.data.start.valueOf() - b.data.start.valueOf())
  .slice(0, 3);
const dateFmt = new Intl.DateTimeFormat('en-GB', { day: '2-digit', month: 'short' });

// John 3:16, King James Version (public domain).
const verse =
  'For God so loved the world, that he gave his only begotten Son, that whosoever believeth in him should not perish, but have everlasting life. John 3:16';
---

<Base>
  <!-- Hero: full-bleed film that pulls back into a framed picture as you scroll -->
  <section class="hero" data-hero-morph>
    <div class="hero__media" data-hero-media>
      <Film poster={earthAtNight} webm="/video/hero.webm" mp4="/video/hero.mp4" label="Slow film of night skies, a valley and a pier at sunset" class="hero__film" />
    </div>
    <div class="hero__content container" data-hero-content>
      <p class="eyebrow" data-reveal="fade">Emmanuel Makandiwa</p>
      <h1 class="hero__title" data-split="hero">Inspiring People.<br />Sharing Life.</h1>
      <div class="hero__actions" data-reveal="up">
        <a href={`/messages/${featured.id}/`} class="btn">Latest message <Icon name="arrowRight" /></a>
        <a href="/about/" class="btn btn--ghost"><span>About him</span></a>
      </div>
    </div>
  </section>

  <!-- Intro: the picture carries over into the About page header -->
  <section class="section section--light intro">
    <div class="container intro__grid">
      <div>
        <p class="eyebrow">About</p>
        <p class="intro__statement" data-scrub-words>
          Emmanuel Makandiwa founded United Family International Church in Harare in 2010. He leads it with his wife, Ruth, and
          together they write Life Lighter, a devotional that comes out every month.
        </p>
        <a href="/about/" class="btn btn--ghost" data-reveal="up"><span>Read his story</span></a>
      </div>
      <a href="/about/" class="intro__image frame" transition:name="about-image" aria-label="About Emmanuel Makandiwa">
        <Image src={oilLamp} alt="A clay oil lamp resting on an open Bible" widths={[500, 800, 1100]} sizes="(max-width: 900px) 100vw, 40vw" data-parallax="0.08" />
      </a>
    </div>
  </section>

  <!-- Scripture ribbon -->
  <div class="ribbon" data-marquee="60" role="img" aria-label={verse}>
    <div class="ribbon__track" data-marquee-track aria-hidden="true">
      <span>{verse}</span><span>{verse}</span>
    </div>
  </div>

  <!-- Messages -->
  <section class="section">
    <div class="container">
      <div class="section-head">
        <div>
          <p class="eyebrow">Messages</p>
          <h2 class="section-title" data-split>Latest messages</h2>
        </div>
        <a href="/messages/" class="btn btn--ghost" data-reveal="up"><span>All messages</span></a>
      </div>
      <div class="messages-grid">
        <div class="messages-grid__featured"><MessageCard entry={featured} size="large" /></div>
        {rest.slice(0, 2).map((m) => <MessageCard entry={m} />)}
      </div>
    </div>
  </section>

  <!-- Gatherings: pinned horizontal track -->
  <section class="stories" data-hscroll>
    <div class="stories__track" data-hscroll-track>
      <div class="stories__intro">
        <p class="eyebrow">Transforming Lives</p>
        <h2 class="section-title" data-split>Where people gather</h2>
        <p class="dim" data-reveal="up">Emmanuel and Ruth Makandiwa have hosted seminars, conferences and masterclasses for years.</p>
        <a href="/transforming-lives/" class="btn btn--ghost" data-reveal="up"><span>See them all</span></a>
      </div>
      {
        stories.map((s, i) => (
          <article class="story">
            <div class="story__media frame">
              <Image src={s.image} alt={s.alt} widths={[500, 900]} sizes="(max-width: 900px) 90vw, 32vw" data-hscroll-media />
            </div>
            <span class="story__num">{String(i + 1).padStart(2, '0')}</span>
            <h3>{s.title}</h3>
            <p class="dim">{s.copy}</p>
          </article>
        ))
      }
    </div>
  </section>

  <!-- Numbers + morphing emblem -->
  <section class="section section--light numbers">
    <div class="container numbers__grid">
      <Emblem class="numbers__emblem" />
      <div class="numbers__stats">
        <div data-reveal="up"><strong data-counter="2010" data-plain>2010</strong><span class="dim">United Family International Church is founded in Harare.</span></div>
        <div data-reveal="up"><strong data-counter="6">6</strong><span class="dim">Countries with UFIC branches: Zimbabwe, Botswana, South Africa, the United Kingdom, Australia and Zambia.</span></div>
        <div data-reveal="up"><strong data-counter="30">30</strong><span class="dim">Daily readings in each monthly edition of Life Lighter.</span></div>
      </div>
    </div>
  </section>

  <!-- Books -->
  <section class="section books-teaser">
    <div class="container books-teaser__grid">
      <div>
        <p class="eyebrow">Books</p>
        <h2 class="section-title" data-split>Life Lighter</h2>
        <p class="lead dim" data-reveal="up">
          A reading for every day of the month: a short message, a Bible passage, a declaration and a prayer. Published monthly, in
          English and Shona.
        </p>
        <a href="/books/" class="btn" data-reveal="up">See the editions <Icon name="arrowRight" /></a>
      </div>
      <div class="books-fan">
        {
          books.map((b, i) => (
            <a href="/books/" class="books-fan__item" style={`--i:${i}`} aria-label={b.data.title}>
              <BookCard book={b} sizes="220px" />
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Watch & listen + events -->
  <section class="section section--light">
    <div class="container split">
      <div class="watch-card" data-reveal="up">
        <Image src={bibleLights} alt="" widths={[600, 1000]} sizes="(max-width: 900px) 100vw, 50vw" class="watch-card__bg" />
        <div class="watch-card__body">
          <p class="eyebrow">Watch and listen</p>
          <h2 class="section-title">Sermons and podcast</h2>
          <p>Sermons are on YouTube. The podcast is on Spotify, and listening uses far less data than watching.</p>
          <a href="/watch/" class="btn">Watch and listen <Icon name="arrowRight" /></a>
        </div>
      </div>
      <div>
        <p class="eyebrow">Events</p>
        <h2 class="section-title" data-split>Coming up</h2>
        <ul class="event-list">
          {
            events.map((e) => (
              <li data-reveal="up">
                <a href="/events/">
                  <time datetime={e.data.start.toISOString()}>{dateFmt.format(e.data.start)}</time>
                  <span>
                    <strong>{e.data.title}</strong>
                    <span class="dim">{e.data.location}</span>
                  </span>
                </a>
              </li>
            ))
          }
        </ul>
        <a href="/events/" class="btn btn--ghost" data-reveal="up"><span>All events</span></a>
      </div>
    </div>
  </section>

  <!-- Give -->
  <section class="give-band">
    <div class="container give-band__inner">
      <div>
        <h2 data-split>Give</h2>
        <p data-reveal="up">Your gifts keep the work of the ministry going.</p>
      </div>
      <a href="/give/" class="btn btn--light">Ways to give <Icon name="arrowRight" /></a>
    </div>
  </section>
</Base>

<style>
  /* Hero */
  .hero {
    position: relative;
    height: 100svh;
    min-height: 600px;
    overflow: clip;
  }
  .hero__media {
    position: absolute;
    inset: 0;
    clip-path: inset(0 0 0 0);
    will-change: clip-path, transform;
  }
  .hero__media :global(.hero__film) {
    width: 100%;
    height: 100%;
  }
  .hero__content {
    position: relative;
    z-index: 2;
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding-bottom: clamp(4rem, 10vh, 8rem);
  }
  .hero__title {
    font-size: clamp(3rem, 10.5vw, 11.5rem);
    line-height: 0.86;
    margin-bottom: 2.25rem;
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  /* Intro */
  .intro__grid {
    display: grid;
    grid-template-columns: 1.3fr 0.7fr;
    gap: clamp(2rem, 6vw, 6rem);
    align-items: center;
  }
  .intro__statement {
    font-size: clamp(1.6rem, 3vw, 2.6rem);
    line-height: 1.25;
    font-weight: 500;
    margin-bottom: 2.5rem;
  }
  .intro__image {
    display: block;
    aspect-ratio: 4 / 5;
  }
  .intro__image :global(img) {
    width: 100%;
    height: 116%;
    object-fit: cover;
  }

  /* Ribbon */
  .ribbon {
    overflow: hidden;
    white-space: nowrap;
    padding-block: 1.4rem;
    background: var(--c-accent);
    color: #fff;
  }
  .ribbon__track {
    display: inline-flex;
    font-family: var(--ff-text);
    font-style: italic;
    font-size: clamp(1.3rem, 2.6vw, 2rem);
  }
  .ribbon__track span {
    padding-right: 3em;
  }
  /* No marquee when animation is off: let the verse wrap instead. */
  :global(html[data-motion='reduced']) .ribbon {
    white-space: normal;
    padding-inline: var(--gutter);
  }
  :global(html[data-motion='reduced']) .ribbon__track span + span {
    display: none;
  }

  .messages-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(2rem, 4vw, 3.5rem) clamp(1.5rem, 3vw, 2.5rem);
  }
  .messages-grid__featured {
    grid-column: 1 / -1;
  }

  /* Stories */
  .stories {
    overflow: hidden;
    background: var(--c-ink-2);
  }
  .stories__track {
    display: flex;
    gap: clamp(1.5rem, 3vw, 3rem);
    padding: var(--section) var(--gutter);
    width: max-content;
    align-items: center;
  }
  .stories__intro {
    width: min(30rem, 80vw);
    flex-shrink: 0;
    padding-right: 2rem;
  }
  .story {
    width: min(26rem, 78vw);
    flex-shrink: 0;
  }
  .story__media {
    aspect-ratio: 3 / 4;
    margin-bottom: 1.25rem;
  }
  .story__media :global(img) {
    width: 124%;
    max-width: none;
    height: 100%;
    margin-left: -12%;
    object-fit: cover;
  }
  .story__num {
    font-family: var(--ff-ui);
    font-size: var(--fs-eyebrow);
    font-weight: 700;
    color: var(--c-accent-text);
    letter-spacing: 0.1em;
  }
  .story h3 {
    font-size: var(--fs-h3);
    margin: 0.4rem 0 0.6rem;
  }
  /* Native swipe row whenever the pinned scroll isn't running. */
  :global(html[data-motion='reduced']) .stories__track {
    width: auto;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: thin;
  }
  :global(html[data-motion='reduced']) .story,
  :global(html[data-motion='reduced']) .stories__intro {
    scroll-snap-align: start;
  }
  @media (max-width: 899px) {
    .stories__track {
      width: auto;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      padding-block: var(--section);
      scrollbar-width: none;
    }
    .story,
    .stories__intro {
      scroll-snap-align: start;
    }
  }

  /* Numbers */
  .numbers__grid {
    display: grid;
    grid-template-columns: 0.6fr 1.4fr;
    gap: clamp(2rem, 6vw, 6rem);
    align-items: center;
  }
  .numbers :global(.numbers__emblem) {
    width: 100%;
    max-width: 300px;
    color: var(--c-accent);
  }
  .numbers__stats {
    display: grid;
    gap: 2.5rem;
  }
  .numbers__stats div {
    display: grid;
    grid-template-columns: 12rem 1fr;
    align-items: baseline;
    gap: 1.5rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--c-line-ink);
  }
  .numbers__stats strong {
    font-family: var(--ff-display);
    font-size: clamp(3.5rem, 7vw, 6.5rem);
    font-weight: 800;
    font-stretch: 70%;
    line-height: 0.9;
  }

  /* Books */
  .books-teaser__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(2rem, 6vw, 6rem);
    align-items: center;
  }
  .books-fan {
    position: relative;
    height: clamp(320px, 40vw, 460px);
  }
  .books-fan__item {
    position: absolute;
    left: 50%;
    top: 50%;
    width: clamp(150px, 16vw, 220px);
    transform: translate(-50%, -50%) translateX(calc((var(--i) - 1) * 86%)) rotate(calc((var(--i) - 1) * 4deg));
    transition: transform 0.8s var(--ease-out);
  }
  .books-fan__item:nth-child(2) {
    z-index: 2;
  }
  .books-fan:hover .books-fan__item {
    transform: translate(-50%, -50%) translateX(calc((var(--i) - 1) * 104%)) rotate(0deg) translateY(-8px);
  }

  /* Watch + events */
  .split {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(2rem, 6vw, 6rem);
    align-items: start;
  }
  .watch-card {
    position: relative;
    overflow: hidden;
    border-radius: var(--radius-lg);
    min-height: 520px;
    display: flex;
    align-items: flex-end;
    color: var(--c-text);
  }
  .watch-card :global(.watch-card__bg) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .watch-card::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(transparent 15%, rgb(20 18 16 / 0.92));
  }
  .watch-card__body {
    position: relative;
    z-index: 2;
    padding: clamp(1.5rem, 4vw, 3rem);
  }
  .watch-card .eyebrow {
    color: var(--c-accent-text);
  }
  .event-list {
    list-style: none;
    margin: 0 0 2rem;
    padding: 0;
  }
  .event-list a {
    display: grid;
    grid-template-columns: 6rem 1fr;
    gap: 1.5rem;
    padding-block: 1.4rem;
    border-bottom: 1px solid var(--c-line-ink);
    transition: padding var(--dur) var(--ease-out);
  }
  .event-list a:hover {
    padding-left: 0.75rem;
  }
  .event-list time {
    font-family: var(--ff-display);
    font-size: 1.7rem;
    font-weight: 800;
    font-stretch: 72%;
    text-transform: uppercase;
    color: var(--c-accent);
  }
  .event-list strong {
    display: block;
    font-weight: 600;
  }

  /* Give band */
  .give-band {
    padding-block: clamp(4rem, 8vw, 7rem);
    background: var(--c-accent);
    color: #fff;
  }
  .give-band__inner {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-end;
    gap: 2rem;
  }
  .give-band h2 {
    font-size: var(--fs-mega);
    line-height: 0.85;
    margin-bottom: 1rem;
  }
  .give-band p {
    margin: 0;
    font-size: var(--fs-lead);
  }
  .btn--light {
    background: var(--c-paper);
    color: var(--c-text-ink);
  }
  .btn--light:hover {
    background: #fff;
  }

  @media (max-width: 900px) {
    .intro__grid,
    .numbers__grid,
    .books-teaser__grid,
    .split,
    .messages-grid {
      grid-template-columns: 1fr;
    }
    .numbers__stats div {
      grid-template-columns: 1fr;
      gap: 0.5rem;
    }
  }
</style>
