---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';

const now = new Date();
const all = (await getCollection('events')).sort((a, b) => a.data.start.valueOf() - b.data.start.valueOf());
const upcoming = all.filter((e) => (e.data.end ?? e.data.start) >= now);
const day = new Intl.DateTimeFormat('en-GB', { day: '2-digit' });
const month = new Intl.DateTimeFormat('en-GB', { month: 'short', year: 'numeric' });
const time = new Intl.DateTimeFormat('en-GB', { hour: '2-digit', minute: '2-digit', timeZone: 'Africa/Harare' });
---

<Base title="Events" description="Upcoming crusades, conferences and gatherings with Prophet Emmanuel Makandiwa.">
  <PageHero eyebrow="Events" title="Events" lead="Crusades, conferences and special services. Times are in Central Africa Time (Harare)." />

  <section class="section events">
    <div class="container">
      {upcoming.length === 0 && <p class="lead dim">No dates announced yet. New events are posted on Facebook and YouTube first.</p>}
      <ul class="ev-list">
        {
          upcoming.map((e) => (
            <li class="ev" data-reveal="up">
              <div class="ev__date">
                <span class="ev__day">{day.format(e.data.start)}</span>
                <span class="ev__month">{month.format(e.data.start)}</span>
              </div>
              <div class="ev__body">
                <h2>{e.data.title}</h2>
                <p class="dim">{e.data.location} · {time.format(e.data.start)} CAT</p>
                <p>{e.data.summary}</p>
                {e.data.link && <a class="btn btn--ghost" href={e.data.link} target="_blank" rel="noopener"><span>Details</span></a>}
              </div>
              {e.data.image && (
                <div class="ev__media frame">
                  <Image src={e.data.image} alt="" widths={[400, 700]} sizes="(max-width: 900px) 100vw, 30vw" />
                  {e.data.placeholder && <span class="tag-sample">Sample</span>}
                </div>
              )}
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</Base>

<style>
  .events {
    padding-top: 0;
  }
  .ev-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .ev {
    display: grid;
    grid-template-columns: 8rem 1fr 22rem;
    gap: clamp(1.5rem, 4vw, 3rem);
    align-items: center;
    padding-block: clamp(2rem, 4vw, 3rem);
    border-top: 1px solid var(--c-line);
  }
  .ev__day {
    display: block;
    font-family: var(--ff-display);
    font-size: clamp(3.5rem, 6vw, 5rem);
    font-weight: 800;
    font-stretch: 68%;
    line-height: 1;
    color: var(--c-accent-text);
  }
  .ev__month {
    font-family: var(--ff-ui);
    font-weight: 700;
    font-size: var(--fs-eyebrow);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .ev h2 {
    font-size: var(--fs-h3);
    margin-bottom: 0.5rem;
  }
  .ev__media {
    aspect-ratio: 16 / 10;
  }
  .ev__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1.2s var(--ease-out);
  }
  .ev:hover .ev__media :global(img) {
    transform: scale(1.06);
  }
  @media (max-width: 900px) {
    .ev {
      grid-template-columns: 5rem 1fr;
    }
    .ev__media {
      grid-column: 1 / -1;
    }
  }
</style>
