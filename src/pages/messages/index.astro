---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import MessageCard from '../../components/MessageCard.astro';

const messages = (await getCollection('messages')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const series = [...new Set(messages.map((m) => m.data.series).filter(Boolean))] as string[];
---

<Base title="Sermons & Messages" description="Sermons and teachings by Prophet Emmanuel Makandiwa.">
  <PageHero
    eyebrow="Sermons & Messages"
    title="Teachings that"
    accent="transform lives"
    lead="Summaries and recordings of messages delivered at United Family International Church and beyond."
  />

  <section class="section messages">
    <div class="container">
      <div class="filters" role="toolbar" aria-label="Filter by series" data-reveal="up">
        <button type="button" class="filter is-active" data-filter="all">All</button>
        {series.map((s) => <button type="button" class="filter" data-filter={s}>{s}</button>)}
      </div>
      <div class="grid" data-filter-grid>
        {
          messages.map((m) => (
            <div class="grid__item" data-series={m.data.series ?? ''}>
              <MessageCard entry={m} />
            </div>
          ))
        }
      </div>
    </div>
  </section>
</Base>

<script>
  import gsap from 'gsap';
  import { Flip } from 'gsap/Flip';
  gsap.registerPlugin(Flip);

  // Filtering re-flows the grid with GSAP Flip, so cards glide to their new
  // positions instead of jumping.
  function setupFilters() {
    const grid = document.querySelector('[data-filter-grid]');
    if (!grid) return;
    const items = Array.from(grid.querySelectorAll<HTMLElement>('.grid__item'));
    const buttons = document.querySelectorAll<HTMLButtonElement>('[data-filter]');
    const reduced = document.documentElement.dataset.motion === 'reduced';
    buttons.forEach((btn) =>
      btn.addEventListener('click', () => {
        buttons.forEach((b) => b.classList.toggle('is-active', b === btn));
        const f = btn.dataset.filter;
        const state = Flip.getState(items);
        items.forEach((it) => (it.hidden = f !== 'all' && it.dataset.series !== f));
        if (reduced) return;
        Flip.from(state, {
          duration: 0.8,
          ease: 'expo.inOut',
          stagger: 0.03,
          absolute: true,
          onEnter: (els) => gsap.fromTo(els, { opacity: 0, scale: 0.9 }, { opacity: 1, scale: 1, duration: 0.6 }),
          onLeave: (els) => gsap.to(els, { opacity: 0, scale: 0.9, duration: 0.4 }),
        });
      }),
    );
  }
  document.addEventListener('astro:page-load', setupFilters);
</script>

<style>
  .messages {
    padding-top: 0;
  }
  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-bottom: 3rem;
  }
  .filter {
    padding: 0.55rem 1.1rem;
    border-radius: 999px;
    box-shadow: inset 0 0 0 1px var(--c-line);
    font-size: 0.85rem;
    transition:
      background var(--dur-fast),
      color var(--dur-fast);
  }
  .filter.is-active,
  .filter:hover {
    background: var(--c-accent);
    color: var(--c-ink);
    box-shadow: none;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(2rem, 4vw, 3.5rem) clamp(1.25rem, 2.5vw, 2rem);
  }
  @media (max-width: 1000px) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 640px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
