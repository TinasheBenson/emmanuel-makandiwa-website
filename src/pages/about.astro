---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import { site } from '../data/site';
import oilLamp from '../assets/media/oil-lamp.jpg';
import valley from '../assets/media/valley.jpg';
import earthAtNight from '../assets/media/earth-at-night.jpg';
import pierSunset from '../assets/media/pier-sunset.jpg';

// TODO: replace with the biography from the current /about/ and
// /who-is-emmanuel-makandiwa/ pages. Photos are placeholders (CREDITS.md);
// the portrait slots need real photographs from the ministry.
const chapters = [
  {
    kicker: 'Ministry',
    title: 'Called to preach',
    body: 'He was a pastor for several years before he started UFIC. Preaching and teaching are still most of what he does, at the church in Harare and on television and YouTube.',
    image: valley,
    alt: 'A valley at golden hour',
  },
  {
    kicker: 'The church',
    title: 'United Family International Church',
    body: 'He founded UFIC in Harare in 2010. It now has branches in Zimbabwe, Botswana, South Africa, the United Kingdom, Australia and Zambia.',
    image: earthAtNight,
    alt: 'City lights seen from orbit at night',
  },
];

// Romans 12:2, King James Version (public domain).
const verse =
  'And be not conformed to this world: but be ye transformed by the renewing of your mind, that ye may prove what is that good, and acceptable, and perfect, will of God.';
---

<Base title="About" description="Emmanuel Makandiwa founded United Family International Church in Harare in 2010 and leads it with his wife, Ruth.">
  <PageHero
    eyebrow="About"
    title="Who is Emmanuel Makandiwa?"
    lead={`He founded ${site.church.name} in Harare in 2010 and leads it with his wife, Ruth. He preaches, teaches and writes.`}
    image={oilLamp}
    imageAlt="A clay oil lamp resting on an open Bible"
    transitionName="about-image"
  />

  <section class="section section--light">
    <div class="container narrow">
      <blockquote class="about__verse">
        <p data-scrub-words>{verse}</p>
        <cite class="eyebrow">Romans 12:2</cite>
      </blockquote>
    </div>
  </section>

  {
    chapters.map((c, i) => (
      <section class:list={['section chapter', { 'chapter--flip': i % 2 }]}>
        <div class="container chapter__grid">
          <div class="chapter__media" data-reveal="clip">
            <Image src={c.image} alt={c.alt} widths={[600, 1000, 1400]} sizes="(max-width: 900px) 100vw, 50vw" />
          </div>
          <div>
            <p class="eyebrow">{c.kicker}</p>
            <h2 class="section-title" data-split>{c.title}</h2>
            <p class="lead dim" data-reveal="up">{c.body}</p>
          </div>
        </div>
      </section>
    ))
  }

  <section class="section section--light">
    <div class="container chapter__grid">
      <div>
        <p class="eyebrow">Family</p>
        <h2 class="section-title" data-split>Emmanuel and Ruth Makandiwa</h2>
        <p class="lead dim" data-reveal="up">
          They lead the church together and write Life Lighter together. Ruth Makandiwa also runs Victorious Ladies, a ministry
          for women that holds a camp meeting every year.
        </p>
        <a class="btn" href={site.ruth.url} target="_blank" rel="noopener" data-reveal="up">Ruth Makandiwa's website</a>
      </div>
      <div class="chapter__media chapter__media--tall" data-reveal="clip">
        <Image src={pierSunset} alt="A wooden pier at sunset" widths={[600, 1000]} sizes="(max-width: 900px) 100vw, 45vw" />
      </div>
    </div>
  </section>
</Base>

<style>
  .narrow {
    max-width: 1100px;
  }
  .about__verse {
    margin: 0;
  }
  .about__verse p {
    font-size: clamp(1.7rem, 3.4vw, 3rem);
    font-style: italic;
    line-height: 1.22;
    margin-bottom: 1.5rem;
  }
  .about__verse cite {
    font-style: normal;
  }
  .chapter__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(2rem, 6vw, 6rem);
    align-items: center;
  }
  .chapter--flip .chapter__media {
    order: 2;
  }
  .chapter__media {
    aspect-ratio: 5 / 4;
    overflow: hidden;
    border-radius: var(--radius-lg);
  }
  .chapter__media--tall {
    aspect-ratio: 4 / 5;
  }
  .chapter__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  @media (max-width: 900px) {
    .chapter__grid {
      grid-template-columns: 1fr;
    }
    .chapter--flip .chapter__media {
      order: 0;
    }
  }
</style>
