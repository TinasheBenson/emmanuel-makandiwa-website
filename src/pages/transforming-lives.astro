---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Film from '../components/Film.astro';
import bibleLights from '../assets/media/bible-lights.jpg';
import { stories } from '../data/gatherings';
---

<Base title="Transforming Lives" description="Seminars, conferences and masterclasses hosted by Emmanuel and Ruth Makandiwa.">
  <PageHero
    eyebrow="Transforming Lives"
    title="Seminars, conferences and nights of prayer"
    lead="Emmanuel and Ruth Makandiwa have hosted seminars, conferences and masterclasses for years. These are the main kinds of gathering."
  />

  <section class="tl-film">
    <Film poster={bibleLights} webm="/video/transforming.webm" mp4="/video/transforming.mp4" label="Slow film of an open Bible, footprints in sand and a mountain lake" class="tl-film__inner" />
  </section>

  <section class="section">
    <div class="container">
      {
        stories.map((p, i) => (
          <article class:list={['pillar', { 'pillar--flip': i % 2 }]}>
            <div class="pillar__media" data-reveal="clip">
              <Image src={p.image} alt={p.alt} widths={[600, 1000, 1400]} sizes="(max-width: 900px) 100vw, 55vw" />
            </div>
            <div class="pillar__copy">
              <span class="pillar__num" data-reveal="fade">{String(i + 1).padStart(2, '0')}</span>
              <h2 class="section-title" data-split>{p.title}</h2>
              <p class="lead dim" data-reveal="up">{p.copy}</p>
            </div>
          </article>
        ))
      }
    </div>
  </section>
</Base>

<style>
  .tl-film {
    padding: clamp(1.5rem, 3vw, 3rem) var(--gutter) 0;
  }
  .tl-film :global(.tl-film__inner) {
    height: min(78vh, 740px);
    border-radius: var(--radius-lg);
  }
  .pillar {
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    gap: clamp(2rem, 6vw, 6rem);
    align-items: center;
    margin-bottom: var(--section);
  }
  .pillar:last-child {
    margin-bottom: 0;
  }
  .pillar--flip .pillar__media {
    order: 2;
  }
  .pillar__media {
    aspect-ratio: 16 / 11;
    border-radius: var(--radius-lg);
    overflow: hidden;
  }
  .pillar__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .pillar__num {
    display: block;
    font-family: var(--ff-display);
    font-size: clamp(3.5rem, 8vw, 7rem);
    font-weight: 800;
    font-stretch: 65%;
    line-height: 1;
    color: var(--c-accent-text);
    margin-bottom: 0.75rem;
  }
  @media (max-width: 900px) {
    .pillar {
      grid-template-columns: 1fr;
    }
    .pillar--flip .pillar__media {
      order: 0;
    }
  }
</style>
